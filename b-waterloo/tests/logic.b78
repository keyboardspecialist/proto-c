/* && / || , and switch with range cases + default + break */
band(a, b) { if (a && b) return(1); return(0); }
bor(a, b)  { if (a || b) return(1); return(0); }
grade(n) {
	auto r;
	switch n {
	case 0 :: 59 :   r = 0; break;
	case 60 :: 79 :  r = 1; break;
	case 80 :: 100 : r = 2; break;
	default:         r = 9;
	}
	return(r);
}
